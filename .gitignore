# Local .terraform directories (providers & modules downloaded by init)
**/.terraform/*

# State files (contain resource IDs, IPs and sometimes secrets)
*.tfstate
*.tfstate.*

# Crash logs
crash.log
crash.*.log

# Saved plan files
*.tfplan
tfplan

# Local override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration
.terraformrc
terraform.rc

# Secret variable files (keep dev.tfvars / prod.tfvars committed — they hold no secrets)
*.secret.tfvars
*.auto.tfvars

# OS / editor files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Ignore terraform.tfvars files, which are likely to contain sensitive data, such as
terraform.tfvars

# Ignore terraform.tfvars.json files, which are likely to contain sensitive data, such as
backend-dev.hcl
backend-prod.hcl